{
  "name": "night-map",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Night Map — an urban discovery, public-space and civic information map",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build && node scripts/build-sw.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "data:basemap": "node scripts/fetch-basemap.mjs",
    "data:terrain": "node scripts/fetch-terrain.mjs",
    "data:buildings": "node scripts/fetch-buildings.mjs",
    "data:building-registry": "node scripts/fetch-building-registry.mjs",
    "data:incidents": "node scripts/fetch-incidents.mjs",
    "data:sfgov": "node scripts/fetch-sfgov.mjs",
    "data:build": "node scripts/build-dataset.mjs",
    "data:access": "node scripts/build-access-records.mjs",
    "data:validate:incidents": "node scripts/validate-incidents.mjs",
    "data:refresh": "node scripts/refresh-data.mjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans": "^5.1.0",
    "@fontsource/newsreader": "^5.1.0",
    "idb": "^8.0.0",
    "maplibre-gl": "^4.7.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.9",
    "vitest": "^2.1.3"
  }
}
